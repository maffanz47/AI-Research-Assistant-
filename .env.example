# ─────────────────────────────────────────────
# Research Gap Finder — Environment Variables
# Copy to .env and fill in your values.
# ─────────────────────────────────────────────

# ── LLM Control ──────────────────────────────
# Set to false to use the real Qwen model via Ollama.
# When true, the pipeline returns a deterministic mock report.
USE_MOCK_LLM=true

# Ollama model tag (must match the tag pulled by gpu_setup.sh)
OLLAMA_MODEL=qwen2.5:14b-instruct-q4_K_M

# Ollama server URL (default: local)
OLLAMA_BASE_URL=http://localhost:11434

# ── Semantic Scholar API ──────────────────────
# Optional — increases rate limits from ~100 req/min to much higher.
# Get a free key at: https://www.semanticscholar.org/product/api
S2_API_KEY=

# ── MLflow Tracking ───────────────────────────
# URI for the MLflow tracking server used by train.py
MLFLOW_TRACKING_URI=http://localhost:5000
